{
  "name": "@cl/desktop",
  "version": "0.0.0",
  "private": true,
  "productName": "Coffee Lounge",
  "type": "module",
  "description": "Counter PC shell (Electron): loads the staff web app from the shop server",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p e2e/tsconfig.json",
    "package": "corepack pnpm build && node scripts/package.mjs",
    "start": "corepack pnpm build && electron .",
    "e2e": "corepack pnpm build && playwright test"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.64.0",
    "electron": "44.7.0"
  }
}
