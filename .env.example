# Copy to .env (never committed) and fill in for your machine.
# Development database login created by scripts/dev/create-dev-db-role.sh (step 2.2).
DATABASE_URL=postgres://cl_dev:CHANGE_ME@localhost:5432/coffee_lounge_dev
TEST_DATABASE_URL=postgres://cl_dev:CHANGE_ME@localhost:5432/coffee_lounge_test

# Shop settings used in development (production values come from system_settings)
SHOP_TIMEZONE=Asia/Karachi
BUSINESS_DAY_CUTOFF=04:00
